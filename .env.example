# ─── Email (Resend) — used by the Netlify Functions to send notification emails ───
# Create an API key at https://resend.com/api-keys and copy it into your Netlify
# environment variables (Site configuration → Environment variables).
# REQUIRED in production: endorsements and suggestions only count as successful
# when the email notification succeeds, so without a valid key the APIs return 500.
# EMAIL_API_KEY is the preferred name; RESEND_API_KEY is accepted as an alias.
EMAIL_API_KEY=
# RESEND_API_KEY=

# Optional — sender address for notification emails.
# Defaults to onboarding@resend.dev (only delivers to the account owner until you
# verify a domain in Resend). For delivery to the owner inbox, set a verified
# sender such as notify@yourdomain.com.
EMAIL_FROM=
# RESEND_FROM=

# Recipients (default to srinikeshchinta@gmail.com when unset):
ENDORSEMENT_RECIPIENT=srinikeshchinta@gmail.com
SUGGESTION_RECIPIENT=srinikeshchinta@gmail.com
# PORTFOLIO_OWNER_EMAIL= (legacy alias for both)

# ─── Storage (Netlify Blobs) ───
# Blobs are enabled via netlify.toml ([[netlify]] enable_blobs = true). On the
# legacy function runtime, set these two so the functions can reach the store:
NETLIFY_SITE_ID=
NETLIFY_API_TOKEN=

# ─── CORS ───
# Optional. If set, the functions echo this origin in Access-Control-Allow-Origin
# (e.g. https://dattasrinikeshchinta.netlify.app). Localhost origins are always
# allowed in development; same-origin requests need no CORS headers at all.
ALLOWED_ORIGIN=
