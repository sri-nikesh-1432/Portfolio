# Resend — used by the Netlify Function to email endorsement notifications to the portfolio owner.
# Create an API key at https://resend.com/api-keys and copy it into a local .env file.
# Without this key, endorsements are still saved — the email is skipped.
RESEND_API_KEY=

# Optional — sender address for notification emails.
# Defaults to onboarding@resend.dev (only delivers to the account owner until you verify a domain).
# RESEND_FROM=you@yourdomain.com

# Optional — owner inbox that receives notifications (defaults to srinikeshchinta@gmail.com).
# PORTFOLIO_OWNER_EMAIL=
